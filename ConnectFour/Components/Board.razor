@using System.Drawing
@inject GameState State

<HeadContent>
    <style>
        :root {
            --board-bg: @ColorTranslator.ToHtml(BoardColor);
            --player1: @ColorTranslator.ToHtml(Player1Color);
            --player2: @ColorTranslator.ToHtml(Player2Color);
        }
    </style>
</HeadContent>

<nav>
    @for (byte i = 0; i < 7; i++)
    {
        var col = i;
        <span title="Click to play a piece" @onclick="() => PlayPiece(col)">🔽</span>
    }
</nav>

<article>
    @winnerMessage  <button style="@ResetStyle" @onclick="ResetGame">Reset the game</button>
    <br />
    <span class="alert-danger">@errorMessage</span>
    <span class="alert-info">@CurrentTurn</span>
</article>

<div>
    <div class="board">
    @for (var i = 0; i < 42; i++)
    {
        <span class="container">
            <span></span>
        </span>
    }
    </div>
    @for (var i = 0; i < 42; i++)
    {
       <span class="@pieces[i]"></span>
    }
</div>

@* Additional feature: scoreboard that tracks wins and consecutive wins *@
<section class="scoreboard">
    <h4>Scoreboard</h4>
    <table>
        <thead>
            <tr>
                <th>Player</th>
                <th>Wins</th>
                <th>Current streak</th>
                <th>Best streak</th>
            </tr>
        </thead>
        <tbody>
            @for (var p = 1; p <= 2; p++)
            {
                var player = p;
                <tr class="@(streakPlayer == player && streakLength > 1 ? "on-streak" : "")">
                    <td><span class="swatch swatch-p@(player)"></span>Player @player</td>
                    <td>@wins[player - 1]</td>
                    <td>@CurrentStreakFor(player)</td>
                    <td>@bestStreak[player - 1]</td>
                </tr>
            }
        </tbody>
    </table>
    <p>Ties: @ties &middot; Games played: @GamesPlayed</p>
    <button @onclick="ResetScores">Reset scores</button>
</section>

@code {
    [Parameter]
    public Color BoardColor { get; set; } = ColorTranslator.FromHtml("yellow");

    [Parameter]
    public Color Player1Color { get; set; } = ColorTranslator.FromHtml("red");

    [Parameter]
    public Color Player2Color { get; set; } = ColorTranslator.FromHtml("blue");

    private string[] pieces = new string[42];
    private string winnerMessage = string.Empty;
    private string errorMessage = string.Empty;

    private string CurrentTurn => (winnerMessage == string.Empty) ? $"Player {State.PlayerTurn}'s Turn" : "";
    private string ResetStyle => (winnerMessage == string.Empty) ? "display: none;" : "";

    // Scoreboard state (index 0 = Player 1, index 1 = Player 2)
    private readonly int[] wins = new int[2];
    private readonly int[] bestStreak = new int[2];
    private int streakPlayer;   // who holds the current streak (0 = nobody)
    private int streakLength;   // how many wins in a row they have
    private int ties;

    private int GamesPlayed => wins[0] + wins[1] + ties;
    private int CurrentStreakFor(int player) => streakPlayer == player ? streakLength : 0;

    protected override void OnInitialized()
    {
        State.ResetBoard();
    }

    private void PlayPiece(byte col)
    {
        errorMessage = string.Empty;
        try
        {
            var player = State.PlayerTurn;
            var turn = State.CurrentTurn;
            var landingRow = State.PlayPiece(col);
            pieces[turn] = $"player{player} col{col} drop{landingRow}";
        }
        catch (ArgumentException ex)
        {
            errorMessage = ex.Message;
        }

        var result = State.CheckForWin();

        // Only count the game once: the moment it goes from "no winner" to a result.
        // Clicking a column after the game ends must not add another win.
        if (winnerMessage == string.Empty && result != GameState.WinState.No_Winner)
        {
            RecordResult(result);
        }

        winnerMessage = result switch
        {
            GameState.WinState.Player1_Wins => $"Player 1 Wins!{StreakNote(1)}",
            GameState.WinState.Player2_Wins => $"Player 2 Wins!{StreakNote(2)}",
            GameState.WinState.Tie => "It's a tie!",
            _ => ""
        };
    }

    private void RecordResult(GameState.WinState result)
    {
        if (result == GameState.WinState.Tie)
        {
            ties++;
            // A tie breaks any streak
            streakPlayer = 0;
            streakLength = 0;
            return;
        }

        var winner = (int)result; // Player1_Wins = 1, Player2_Wins = 2
        wins[winner - 1]++;

        if (streakPlayer == winner)
        {
            streakLength++;
        }
        else
        {
            streakPlayer = winner;
            streakLength = 1;
        }

        bestStreak[winner - 1] = Math.Max(bestStreak[winner - 1], streakLength);
    }

    private string StreakNote(int player) =>
        streakPlayer == player && streakLength > 1 ? $" That's {streakLength} in a row!" : "";

    void ResetGame()
    {
        State.ResetBoard();
        winnerMessage = string.Empty;
        errorMessage = string.Empty;
        pieces = new string[42];
    }

    void ResetScores()
    {
        Array.Clear(wins);
        Array.Clear(bestStreak);
        streakPlayer = 0;
        streakLength = 0;
        ties = 0;
    }
}
